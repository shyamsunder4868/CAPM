### =====================================================
### 1. SERVICE METADATA
### =====================================================

GET http://localhost:4004/odata/v4/app/$metadata


### =====================================================
### 2. GET ALL DEPARTMENTS
### =====================================================

GET http://localhost:4004/odata/v4/app/Departments


### =====================================================
### 3. GET ALL EMPLOYEES
### =====================================================

GET http://localhost:4004/odata/v4/app/Employees


### =====================================================
### 4. GET ALL CUSTOMERS
### =====================================================

GET http://localhost:4004/odata/v4/app/Customers


### =====================================================
### 5. GET ALL ACCOUNTS
### =====================================================

GET http://localhost:4004/odata/v4/app/Accounts


### =====================================================
### 6. GET ALL TRANSACTIONS
### =====================================================

GET http://localhost:4004/odata/v4/app/Transactions


### =====================================================
### 7. CREATE DEPARTMENT
### =====================================================

POST http://localhost:4004/odata/v4/app/Departments
Content-Type: application/json

{
    "Name": "IT"
}


### =====================================================
### 8. CREATE ANOTHER DEPARTMENT
### =====================================================

POST http://localhost:4004/odata/v4/app/Departments
Content-Type: application/json

{
    "Name": "HR"
}


### =====================================================
### 9. CREATE CUSTOMER
### =====================================================

POST http://localhost:4004/odata/v4/app/Customers
Content-Type: application/json

{
    "Name": "Rahul Sharma",
    "Email": "rahul@gmail.com"
}


### =====================================================
### 10. GET EMPLOYEE BY ID
### Replace ID with actual Employee UUID
### =====================================================

GET http://localhost:4004/odata/v4/app/Employees(<EMPLOYEE_UUID>)


### =====================================================
### 11. GET EMPLOYEES WITH FILTER
### =====================================================

GET http://localhost:4004/odata/v4/app/Employees?$filter=Status eq 'Active'


### =====================================================
### 12. GET EMPLOYEES WITH SELECT
### =====================================================

GET http://localhost:4004/odata/v4/app/Employees?$select=EmployeeID,FirstName,LastName,Email,Salary,Status



### =====================================================
### 15. TRANSFER MONEY
### Replace ACCOUNT UUIDs
### =====================================================

POST http://localhost:4004/odata/v4/app/transferMoney
Content-Type: application/json

{
    "fromAccountID": "<SOURCE_ACCOUNT_UUID>",
    "toAccountID": "<TARGET_ACCOUNT_UUID>",
    "amount": 500,
    "referenceID": "TRX-001"
}


### =====================================================
### 16. GET TRANSACTIONS AFTER TRANSFER
### =====================================================

GET http://localhost:4004/odata/v4/app/Transactions



