{
  "name": "CAPM_PROJECT",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/audit-logging": ">=0",
    "@cap-js/hana": "^2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "messaging": {
        "kind": "enterprise-messaging"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "portal": true,
      "application-logging": true
    },
    "build": {
      "target": "gen"
    },
    "hana": {
      "deploy": {
        "service": "PracticeHDi-freeInstance"
      }
    }
  }
}
